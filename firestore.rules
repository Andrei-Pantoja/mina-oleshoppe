rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid == "REPLACE_WITH_ADMIN_UID" || 
            request.auth.uid == "REPLACE_WITH_ADMIN_UID");
    }
 
    // Get admin details based on UID
    function getAdminInfo() {
      return request.auth.uid == "REPLACE_WITH_ADMIN_UID" ? 
        {"name": "", "email": "@gmail.com", "sellerUrl": "https://m.me/"} :
        request.auth.uid == "REPLACE_WITH_ADMIN_UID" ? 
        {"name": "", "email": "@gmail.com", "sellerUrl": "https://m.me/"} :
        null;
    }
 
    // Helper function to validate product structure
    function isValidProduct(product) {
      return product.keys().hasAll(['name', 'price']) &&
        product.name is string &&
        product.name.size() > 0 &&
        product.price is number &&
        product.price >= 0;
    }
 
    // Helper function to validate author field (optional but must be string if present)
    function isValidAuthor(product) {
      return !('author' in product) || 
        (product.author is string && product.author.size() > 0);
    }
 
    // Helper function to validate brands field (array or string)
    function isValidBrands(product) {
      return (!('brands' in product) && !('brand' in product)) ||
        (('brands' in product) && product.brands is list) ||
        (('brand' in product) && product.brand is string);
    }
 
    // Public read products with filtering support
    match /products/{productId} {
      allow read: if true;
 
      // Allow anyone to increment "views" only.
      allow update: if request.resource.data.diff(resource.data).changedKeys().hasOnly(['views'])
        && request.resource.data.views is number
        // allow if old views missing OR new >= old
        && ( !('views' in resource.data) || request.resource.data.views >= resource.data.views );
 
      // Admin can create/update products with validation
      allow create: if isAdmin() && 
        isValidProduct(request.resource.data) &&
        isValidAuthor(request.resource.data) &&
        isValidBrands(request.resource.data);
 
      allow update: if isAdmin() && 
        isValidProduct(request.resource.data) &&
        isValidAuthor(request.resource.data) &&
        isValidBrands(request.resource.data);
 
      // Admin can delete products
      allow delete: if isAdmin();
    }
 
    // Shop configuration documents (for categories and brands)
    match /shopConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}